<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="web.mapper.DataMapper">

    <select id="searchByCondition" resultType="map">
        SELECT ${columnName}, Time, Building_ID FROM ${tableName}
        <where>
            <if test="buildingName != null and buildingName != ''">
                AND Building_Type LIKE CONCAT('%', #{buildingName}, '%')
            </if>
            <if test="beginDatetime != null and beginDatetime != ''">
                AND Time &gt;= #{beginDatetime}
            </if>
            <if test="endDatetime != null and endDatetime != ''">
                AND Time &lt;= #{endDatetime}
            </if>
        </where>
    </select>

</mapper>
