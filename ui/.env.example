# Server-side proxy settings (do not expose secrets in browser code)
RAGFLOW_API_KEY=ragflow-your-api-key
RAGFLOW_BASE_URL=https://your-ragflow-domain.com
RAGFLOW_PORT=80
RAGFLOW_SHARED_ID=your-shared-id
RAGFLOW_SHARE_AUTH=your-share-auth-token

# Client-side embed settings
VITE_RAGFLOW_BASE_URL=http://localhost
VITE_RAGFLOW_CHAT_ID=your-chat-id
VITE_RAGFLOW_SHARED_ID=your-shared-id
VITE_RAGFLOW_SHARE_AUTH=your-share-auth-token
